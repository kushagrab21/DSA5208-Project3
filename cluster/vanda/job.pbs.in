#!/bin/bash
# GENERATED by checks/run_plan.py pbs --plan {{PLAN}} --job {{PLANJOB}}. Do not edit; change the plan instead.
# Estimate: {{ESTIMATE}}
# Submit from the repository root on a Vanda login node:   qsub cluster/generated/{{PLAN}}/{{PLANJOB}}.pbs
#PBS -N {{JOBNAME}}
#PBS -l {{SELECT}}
#PBS -l place={{PLACE}}
#PBS -l walltime={{WALLTIME}}
#PBS -j oe
#PBS -o cluster/logs/
{{QUEUE_LINE}}
{{PROJECT_LINE}}
set -eo pipefail   # no -u: module and ebenv scripts read unset variables
cd "${PBS_O_WORKDIR:?submit from the repository root}"
mkdir -p cluster/logs results/vanda

P3_FLAVOR=cpu
[[ "{{PLANJOB}}" == *gpu* ]] && P3_FLAVOR=offload
export P3_FLAVOR
source cluster/vanda/env.sh
REC="results/vanda/${PBS_JOBID}.csv"

# Refuses unless this job is in the plan (or recorded there as unplanned with a reason); records the start time.
python3 checks/run_plan.py job-start --plan {{PLAN}} --job {{PLANJOB}}
trap 'python3 checks/run_plan.py job-end --plan {{PLAN}} --job {{PLANJOB}} || true' EXIT

{{BODY}}
