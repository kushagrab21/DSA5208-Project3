 "cases": [
  {
   "id": "V1",
   "name": "order-2d",
   "purpose": "2D serial solver converges and its error against the exact solution falls as h^2",
   "why": "the 5-/7-point stencil is second order, so halving h divides the error by 4 (order 2); solves use tol 1e-12 so the algebraic error is far below the discretisation error"
  },
  {
   "id": "V2",
   "name": "order-3d",
   "purpose": "3D serial solver converges and its error against the exact solution falls as h^2",
   "why": "the 5-/7-point stencil is second order, so halving h divides the error by 4 (order 2); solves use tol 1e-12 so the algebraic error is far below the discretisation error"
  },
  {
   "id": "V3",
   "name": "agree-2d",
   "purpose": "2D parallel runs (1D/2D splits, uneven blocks, both halo variants, threads) equal the serial run to rounding",
   "why": "after the same 25 iterations, a P-rank run differs from the 1-rank run only in the order in which the partial sums of each dot product are added (the stencil and vector updates are the same operations on the same numbers once the halos are right); CG amplifies those last-bit differences to ~1e-13 here. 1e-10 leaves a margin of more than 100x over that and is ~9 orders below the effect of one wrong halo face (~0.5)"
  },
  {
   "id": "V4",
   "name": "agree-3d",
   "purpose": "3D parallel runs (1D/2D/3D splits, uneven blocks, both halo variants, threads) equal the serial run to rounding",
   "why": "after the same 25 iterations, a P-rank run differs from the 1-rank run only in the order in which the partial sums of each dot product are added (the stencil and vector updates are the same operations on the same numbers once the halos are right); CG amplifies those last-bit differences to ~1e-13 here. 1e-10 leaves a margin of more than 100x over that and is ~9 orders below the effect of one wrong halo face (~0.5)"
  },
  {
   "id": "V5",
   "name": "pipelined",
   "purpose": "pipelined CG (1 and 4 ranks) reaches the same converged answer as classic CG, 2D and 3D",
   "why": "pipelined CG uses different recurrences, so its iterates are not rounding-equal to classic CG; only converged answers can be compared. For any x, ||x - x*||/||x*|| <= cond(A) ||b - Ax||/||b||, with cond(A) = cot^2(pi h/2) for this operator, so two converged answers must satisfy ||x_p - x_s||/||x_s|| <= cond(A) (rho_p + rho_s) / (1 - cond(A) rho_s), rho = true relative residual"
  }
 ],
